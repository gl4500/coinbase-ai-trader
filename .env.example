# ── Coinbase CDP Credentials ──────────────────────────────────────────────────
# Key Name from coinbase.com Developer Platform (organizations/.../apiKeys/...)
COINBASE_API_KEY_NAME=
# EC Private Key PEM (paste the full -----BEGIN EC PRIVATE KEY----- block)
COINBASE_API_PRIVATE_KEY=

# ── App Settings ──────────────────────────────────────────────────────────────
DATABASE_URL=coinbase.db
LOG_LEVEL=INFO
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_API_KEY=
# Set to false ONLY when ready for live trading
DRY_RUN=true

# ── Trading Parameters ────────────────────────────────────────────────────────
# Max number of USD spot pairs to track (sorted by 24h volume)
MAX_TRACKED_PRODUCTS=100
# Minimum 24h USD volume to include a pair
MIN_VOLUME_24H=1000000
# Minimum signal strength (0–1) before generating a signal
MIN_SIGNAL_STRENGTH=0.6
# Maximum single position size in USD
MAX_POSITION_USD=500
# RSI thresholds
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ── Risk Management ────────────────────────────────────────────────────────────
# Kelly fraction applied to raw Kelly bet (0.25 = quarter-Kelly)
KELLY_FRACTION=0.25
# Maximum total portfolio exposure across all open positions (USD)
MAX_TOTAL_EXPOSURE=5000
# ATR-based position sizing: risk this fraction of account balance per trade
ATR_RISK_PCT=0.01
# Stop distance multiplier (stop = ATR_MULTIPLIER × ATR)
ATR_MULTIPLIER=2.0
# Drawdown circuit breaker: halt trading if daily loss exceeds this fraction
DAILY_DRAWDOWN_LIMIT=0.05
# Drawdown circuit breaker: halt trading if weekly loss exceeds this fraction
WEEKLY_DRAWDOWN_LIMIT=0.10

# ── Regime Detection ───────────────────────────────────────────────────────────
# ADX value below which market is considered ranging (suppresses momentum signals)
ADX_TREND_THRESHOLD=25.0

# ── Scanner Settings ──────────────────────────────────────────────────────────
# Full market scan interval in seconds (default 300 = 5 min)
SCAN_INTERVAL_SECONDS=300

OLLAMA_MODEL=qwen2.5:7b

# ── Scan Performance ───────────────────────────────────────────────────────────
# Skip LLM when CNN probability is already this decisive (default 0.75)
# cnn_prob > 0.75 or < 0.25 → skip Ollama, saves 10-30s per product
# Lower = call LLM more often | Higher = call LLM less often
LLM_SKIP_THRESHOLD=0.75
# Sleep between products during a scan in seconds (default 0.1)
# Raise to 0.3+ if Coinbase rate-limits you; lower to 0.05 to scan faster
SCAN_SLEEP_SECS=0.1

# ── CNN Architecture (Session 45) ──────────────────────────────────────────────
# Which CNN class to instantiate at agent boot.
#   glu2 (default) — production arch (~280k params), 4 GLU conv blocks + 2-LSTM,
#                    saves to backend/cnn_model.pt
#   glu1           — capacity-reduced sibling (~12k params), 2 GLU conv + 1-LSTM,
#                    saves to backend/cnn_model_glu1.pt against an independent
#                    cnn_best_loss_glu1.txt baseline (does not touch glu2 files)
# Read once at agent construction — flips take effect on next backend restart.
CNN_ARCH=glu2

# Leader filter (#leader-filter) — additive, unused by trading agents
COINMARKETCAP_API_KEY=
COINMARKETCAP_DISABLED=
LEADER_MIN_MARKET_CAP_USD=50000000
LEADER_MIN_VOLUME_24H_USD=5000000
LEADER_MAX_FDV_MCAP_RATIO=5.0
LEADER_SUPPLY_DIVERGENCE_THRESHOLD=0.10
LEADER_TOP_N=3
