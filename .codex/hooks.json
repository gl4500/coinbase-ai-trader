{
  "description": "Live-backend guard (tools/agent_guard/live_guard.py from this checkout's git root): blocks tests, risky commits and process kills while the backend is live.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/gl450/polymarket_app/.venv/Scripts/python.exe -c \"import os,runpy,subprocess,sys;r=subprocess.run(['git','rev-parse','--show-toplevel'],capture_output=True,text=True).stdout.strip();p=os.path.join(r,'tools','agent_guard','live_guard.py');sys.argv=[p]+sys.argv[1:];runpy.run_path(p,run_name='__main__')\" --port 8001 --training-marker train_worker.py --commit-needs-staged-py",
            "timeout": 30,
            "statusMessage": "Checking the live backend"
          }
        ]
      }
    ]
  }
}
